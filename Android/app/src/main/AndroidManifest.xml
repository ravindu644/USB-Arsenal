<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rich haptics (the bind sequence) go through Vibrator, which needs it -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="USB Arsenal"
        android:theme="@style/Lcd">
        <!-- Compose redraws for every one of these itself. Recreating the activity would cancel a
             su request mid-dialog and ask again, and replay every typed session; a gamepad or
             keyboard connecting is one of them, and this app is meant to be driven by one -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|fontScale|fontWeightAdjustment|uiMode|colorMode|keyboard|keyboardHidden|navigation|touchscreen|locale|layoutDirection|mcc|mnc"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
