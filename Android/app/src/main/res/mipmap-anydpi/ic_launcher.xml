<?xml version="1.0" encoding="utf-8"?>
<!-- Every mask, round or not, is the launcher's; the monochrome layer is Android 13's themed icon.
     The splash's Pin is the right size here too: a layer is scaled to the icon, and its 48-unit
     viewport puts Pin at a third of the 108dp layer, half of the 72dp shown -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/lcd" />
    <foreground android:drawable="@drawable/splash_pin" />
    <monochrome android:drawable="@drawable/splash_pin" />
</adaptive-icon>
