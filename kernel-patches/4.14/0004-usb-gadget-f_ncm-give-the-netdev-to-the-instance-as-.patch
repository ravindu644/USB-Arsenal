From fac772515dfc06dc0f8e2414d057f1d328e4b953 Mon Sep 17 00:00:00 2001
From: ravindu644 <droidcasts@protonmail.com>
Date: Mon, 19 Oct 2026 00:24:29 +0530
Subject: [PATCH] usb: gadget: f_ncm: give the netdev to the instance, as
 mainline does

Samsung's f_ncm creates the network device in ncm_bind() instead of
ncm_alloc_inst(), and under CONFIG_USB_CONFIGFS_UEVENT frees it again in
ncm_unbind(). Until the first bind opts->net is NULL, but the
u_ether_configfs stores (dev_addr, host_addr, qmult) dereference it
without a check, so setting a MAC address on a freshly created NCM
function panics the kernel:

  Unable to handle kernel NULL pointer dereference at 000009ac
  PC is at ncm_opts_dev_addr_store+0x84/0xd0

Reproduced on an SM-G977N by USB Arsenal writing dev_addr before bind,
which works on every mainline kernel.

Backport the mainline lifecycle (as in 5.15): allocate the netdev in
ncm_alloc_inst(), register it once at the first bind, keep it across
unbind, and release it in ncm_free_inst() (free_netdev() when it was
never registered). The bind error path no longer frees a netdev the
instance still owns. The interface keeps Samsung's ncm%d naming.

Compiled with the tree's own clang command line.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: ravindu644 <droidcasts@protonmail.com>
---
 drivers/usb/gadget/function/f_ncm.c | 63 ++++++++++++-----------------
 1 file changed, 25 insertions(+), 38 deletions(-)

diff --git a/drivers/usb/gadget/function/f_ncm.c b/drivers/usb/gadget/function/f_ncm.c
index cc1fb064d..f4d81cd51 100644
--- a/drivers/usb/gadget/function/f_ncm.c
+++ b/drivers/usb/gadget/function/f_ncm.c
@@ -1457,27 +1457,19 @@ ncm_bind(struct usb_configuration *c, struct usb_function *f)
 	 * with list_for_each_entry, so we assume no race condition
 	 * with regard to ncm_opts->bound access
 	 */
-	if (!ncm_opts->bound) {
-		mutex_lock(&ncm_opts->lock);
-
-		ncm_opts->net = gether_setup_name_default("ncm");
-		if (IS_ERR(ncm_opts->net)) {
-			status = PTR_ERR(ncm_opts->net);
-			mutex_unlock(&ncm_opts->lock);
-			ERROR(cdev, "%s: failed to setup ethernet\n", f->name);
-			return status;
-		}
-
-		ncm->port.ioport = netdev_priv(ncm_opts->net);
-		gether_set_gadget(ncm_opts->net, cdev->gadget);
-		status = gether_register_netdev(ncm_opts->net);
-		mutex_unlock(&ncm_opts->lock);
-		if (status) {
-			free_netdev(ncm_opts->net);
-			return status;
-		}
-		ncm_opts->bound = true;
-	}
+	/*
+	 * The netdev belongs to the instance, created in ncm_alloc_inst() as
+	 * mainline does, so its configfs attributes (dev_addr, host_addr,
+	 * qmult) are valid before the first bind. Register it once.
+	 */
+	mutex_lock(&ncm_opts->lock);
+	ncm->port.ioport = netdev_priv(ncm_opts->net);
+	gether_set_gadget(ncm_opts->net, cdev->gadget);
+	status = ncm_opts->bound ? 0 : gether_register_netdev(ncm_opts->net);
+	mutex_unlock(&ncm_opts->lock);
+	if (status)
+		return status;
+	ncm_opts->bound = true;
 	/* need to clear local value */
 	ncm_reset_values(ncm);
 
@@ -1602,9 +1594,7 @@ ncm_bind(struct usb_configuration *c, struct usb_function *f)
 		ncm->port.in_ep->driver_data = NULL;
 
 netdev_cleanup:
-	ncm_opts->bound = false;
-	gether_cleanup(netdev_priv(ncm_opts->net));
-
+	/* the netdev stays with the instance; ncm_free_inst() releases it */
 	ERROR(cdev, "%s: can't bind, err %d\n", f->name, status);
 
 	return status;
@@ -1832,11 +1822,8 @@ static void ncm_free_inst(struct usb_function_instance *f)
 	opts = container_of(f, struct f_ncm_opts, func_inst);
 	if (opts->bound)
 		gether_cleanup(netdev_priv(opts->net));
-/*
-To prevent crash in case we are not bound.
 	else
 		free_netdev(opts->net);
-*/
 	kfree(opts);
 #ifdef CONFIG_USB_ANDROID_SAMSUNG_COMPOSITE
 	mutex_lock(&ncm_samsung_lock);
@@ -1855,6 +1842,13 @@ static struct usb_function_instance *ncm_alloc_inst(void)
 		return ERR_PTR(-ENOMEM);
 	mutex_init(&opts->lock);
 	opts->func_inst.free_func_inst = ncm_free_inst;
+	opts->net = gether_setup_name_default("ncm");
+	if (IS_ERR(opts->net)) {
+		struct net_device *net = opts->net;
+
+		kfree(opts);
+		return ERR_CAST(net);
+	}
 	config_group_init_type_name(&opts->func_inst.group, "", &ncm_func_type);
 #ifdef CONFIG_USB_ANDROID_SAMSUNG_COMPOSITE
 	mutex_lock(&ncm_samsung_lock);
@@ -1881,13 +1875,10 @@ static void ncm_free(struct usb_function *f)
 static void ncm_unbind(struct usb_configuration *c, struct usb_function *f)
 {
 	struct f_ncm *ncm = func_to_ncm(f);
-#ifdef CONFIG_USB_CONFIGFS_UEVENT
-	struct f_ncm_opts	*opts;
-#endif
-#ifdef CONFIG_USB_CONFIGFS_UEVENT
-	opts = container_of(f->fi, struct f_ncm_opts, func_inst);
-	opts->bound = false;
-#endif
+
+	/* The netdev outlives the bind, as in mainline; freeing it here left
+	 * every rebind with a new interface and the instance pointing at a
+	 * freed one. */
 	DBG(c->cdev, "ncm unbind\n");
 
 	ncm_string_defs[0].id = 0;
@@ -1895,10 +1886,6 @@ static void ncm_unbind(struct usb_configuration *c, struct usb_function *f)
 
 	kfree(ncm->notify_req->buf);
 	usb_ep_free_request(ncm->notify, ncm->notify_req);
-
-#ifdef CONFIG_USB_CONFIGFS_UEVENT
-	gether_cleanup(netdev_priv(opts->net));
-#endif
 }
 
 static struct usb_function *ncm_alloc(struct usb_function_instance *fi)
-- 
2.56.0

